<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="InventorySystem.VisualElementsTemplates.Dock"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:template="clr-namespace:InventorySystem.VisualElementsTemplates">

	<Grid
        RowDefinitions="Auto,auto"
        ColumnDefinitions="*,auto"
        ColumnSpacing="12"
        Padding="16,8">
		<template:AddNewMenu
            x:Name="AddNewMenuDisplay"
            Grid.Row="0"
            HorizontalOptions="Fill">
        </template:AddNewMenu>
		<Border
            Grid.Row="1"
            Grid.Column="0"
            Padding="0"
            BackgroundColor="Gray"
            Opacity="1"
            Stroke="Black"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 28">
			<Grid
                ColumnDefinitions="*,*,*"
            >
				<ImageButton
                    Grid.Column="0"
                    Source="home.png"
                    Margin="8,0,0,0"
                    BackgroundColor="Transparent"
                    HeightRequest="42"
                    WidthRequest="42"
                    Clicked="HomeButtonClicked" 
                >
					<ImageButton.Behaviors>
						<toolkit:IconTintColorBehavior TintColor="White" />
					</ImageButton.Behaviors>
				</ImageButton>

				<ImageButton
                    Source="polaroid.png"
                    Grid.Column="1"
                    BackgroundColor="Transparent"
                    HeightRequest="42"
                    WidthRequest="42"
                    Clicked="InventoryButtonClicked"
                >
					<ImageButton.Behaviors>
						<toolkit:IconTintColorBehavior TintColor="White" />
					</ImageButton.Behaviors>
				</ImageButton>

				<ImageButton
                    Source="usermultiple.png"
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    BackgroundColor="Transparent"
                    HeightRequest="42"
                    WidthRequest="42"
                    Clicked="PurveyorButtonClicked"
                >
					<ImageButton.Behaviors>
						<toolkit:IconTintColorBehavior TintColor="White" />
					</ImageButton.Behaviors>
				</ImageButton>

			</Grid>
		</Border>
		<ImageButton
            Grid.Row="1"
            Grid.Column="1"
            Source="add.png"
			Padding="0"
            BackgroundColor="#75E843"
            WidthRequest="72"
            HeightRequest="72"
            CornerRadius="36"
            VerticalOptions="Center"
            Clicked="AddButtonClicked">
			<ImageButton.Behaviors>
				<toolkit:IconTintColorBehavior TintColor="White" />
			</ImageButton.Behaviors>
		</ImageButton>
	</Grid>

</ContentView>