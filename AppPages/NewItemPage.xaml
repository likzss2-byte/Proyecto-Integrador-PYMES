<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventorySystem.AppPages.NewItemPage"
             Title="Nuevo producto">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">
            <Label Text="Registrar producto" FontSize="Large" FontAttributes="Bold" />
            <Entry x:Name="LookupCode" Placeholder="Código manual o lector USB" Completed="LookupCode_Completed" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="Buscar código" Clicked="LookupCode_Clicked" />
                <Button Grid.Column="1" Text="Leer imagen" Clicked="ReadImage_Clicked" />
            </Grid>
            <Label x:Name="LookupMessage" FontSize="Small" />

            <Entry x:Name="SkuEntry" Placeholder="SKU interno *" />
            <Entry x:Name="BarcodeEntry" Placeholder="Código de barras (opcional)" />
            <Entry x:Name="NameEntry" Placeholder="Nombre *" />
            <Entry x:Name="BrandEntry" Placeholder="Marca" />
            <Editor x:Name="DescriptionEntry" Placeholder="Descripción" AutoSize="TextChanges" />
            <Picker x:Name="UnitPicker" Title="Unidad de medida">
                <Picker.Items>
                    <x:String>Unidad</x:String>
                    <x:String>Kilogramo</x:String>
                    <x:String>Litro</x:String>
                </Picker.Items>
            </Picker>
            <Entry x:Name="InitialStockEntry" Placeholder="Inventario inicial" Keyboard="Numeric" />
            <Entry x:Name="MinimumStockEntry" Placeholder="Stock mínimo" Keyboard="Numeric" />
            <Entry x:Name="SalePriceEntry" Placeholder="Precio de venta" Keyboard="Numeric" />
            <HorizontalStackLayout Spacing="8">
                <Label Text="Activo" VerticalOptions="Center" />
                <Switch x:Name="ActiveSwitch" IsToggled="True" />
            </HorizontalStackLayout>
            <Button Text="Guardar producto" BackgroundColor="#75E843" Clicked="SaveProduct_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
