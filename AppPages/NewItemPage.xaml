<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventorySystem.AppPages.NewItemPage"
             Title="Agregar producto">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource StandardCreatePageContent}">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Consulta por código de barras" Style="{StaticResource SectionTitle}" />
                    <Entry x:Name="LookupCode" Style="{StaticResource FormEntry}" Completed="LookupCode_Completed" />
                    <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Start" JustifyContent="Start">
                        <Button Text="Buscar código" Style="{StaticResource PrimaryButton}" Clicked="LookupCode_Clicked" />
                        <Button Text="Escanear con cámara" Style="{StaticResource SecondaryButton}" Clicked="ScanCamera_Clicked" Margin="10,0,0,8" />
                        <Button Text="Leer desde imagen" Style="{StaticResource SecondaryButton}" Clicked="ReadImage_Clicked" Margin="10,0,0,8" />
                    </FlexLayout>
                    <Label x:Name="LookupMessage" Style="{StaticResource InfoText}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Datos del producto" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="18" RowDefinitions="Auto,Auto">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Código de barras" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="BarcodeEntry" Style="{StaticResource FormEntry}" />
                            <Label x:Name="BarcodeErrorLabel" Style="{StaticResource ErrorText}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Nombre *" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="NameEntry" Style="{StaticResource FormEntry}" />
                            <Label x:Name="NameErrorLabel" Style="{StaticResource ErrorText}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Margin="0,12,0,0" Spacing="4">
                            <Label Text="Marca" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="BrandEntry" Style="{StaticResource FormEntry}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Spacing="4">
                            <Label Text="Descripción" Style="{StaticResource FieldLabel}" />
                            <Editor x:Name="DescriptionEntry" Style="{StaticResource FormEditor}" AutoSize="TextChanges" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Proveedor" Style="{StaticResource FieldLabel}" />
                            <Picker x:Name="ProductSupplierPicker" Style="{StaticResource FormPicker}"
                                    Title="Sin proveedor" ItemDisplayBinding="{Binding CompanyName}"
                                    SelectedIndexChanged="ProductSupplierPicker_SelectedIndexChanged" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Costo unitario del proveedor *" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="ReferenceCostEntry" Style="{StaticResource FormEntry}" Keyboard="Numeric"
                                   IsEnabled="False" Placeholder="Selecciona un proveedor" />
                            <Label Text="Se usará como costo sugerido al registrar entradas." Style="{StaticResource HelperText}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Unidad de medida *" Style="{StaticResource FieldLabel}" />
                            <Picker x:Name="UnitPicker" Style="{StaticResource FormPicker}">
                                <Picker.Items>
                                    <x:String>Unidad</x:String><x:String>Kilogramo</x:String><x:String>Litro</x:String>
                                </Picker.Items>
                            </Picker>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="¿Controla caducidad? *" Style="{StaticResource FieldLabel}" />
                            <Picker x:Name="ExpirationModePicker" Style="{StaticResource FormPicker}">
                                <Picker.Items>
                                    <x:String>Selecciona una opción</x:String><x:String>Sí, por lote</x:String><x:String>No perecedero</x:String>
                                </Picker.Items>
                            </Picker>
                            <Label x:Name="ExpirationModeErrorLabel" Style="{StaticResource ErrorText}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Stock mínimo" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="MinimumStockEntry" Style="{StaticResource FormEntry}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Precio de venta" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="SalePriceEntry" Style="{StaticResource FormEntry}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label x:Name="NumericErrorLabel" Style="{StaticResource ErrorText}" />
                    <HorizontalStackLayout Spacing="8">
                        <Switch x:Name="ActiveSwitch" IsToggled="True" />
                        <Label Text="Producto activo" VerticalOptions="Center" Style="{StaticResource FieldLabel}" />
                    </HorizontalStackLayout>
                    <Label x:Name="FormErrorLabel" Style="{StaticResource ErrorText}" />
                    <Button x:Name="SaveProductButton" Text="Guardar producto" Style="{StaticResource PrimaryButton}"
                            HorizontalOptions="Start" Clicked="SaveProduct_Clicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
