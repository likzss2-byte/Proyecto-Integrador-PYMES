<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventorySystem.AppPages.NewOrderPage"
             Title="Nueva entrada">
    <ScrollView>
        <VerticalStackLayout Padding="28,24" Spacing="18" MaximumWidthRequest="980" HorizontalOptions="Center">
            <VerticalStackLayout Spacing="4">
                <Label Text="Entrada directa de inventario" Style="{StaticResource DesktopPageTitle}" />
                <Label Text="Registra mercancía que ya llegó al almacén." Style="{StaticResource DesktopPageSubtitle}" />
            </VerticalStackLayout>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Proveedor (opcional)" Style="{StaticResource FieldLabel}" />
                    <Picker x:Name="SupplierPicker" Style="{StaticResource FormPicker}" Title="Selecciona un proveedor" />

                    <Border Style="{StaticResource FormSection}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Agregar producto y lote" Style="{StaticResource SectionTitle}" />
                            <Label Text="Código de barras o SKU *" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="ProductCodeEntry" Style="{StaticResource FormEntry}" Completed="AddLine_Clicked" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Cantidad *" Style="{StaticResource FieldLabel}" />
                                    <Entry x:Name="QuantityEntry" Style="{StaticResource FormEntry}" Keyboard="Numeric" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Costo unitario *" Style="{StaticResource FieldLabel}" />
                                    <Entry x:Name="UnitCostEntry" Style="{StaticResource FormEntry}" Keyboard="Numeric" />
                                </VerticalStackLayout>
                            </Grid>
                            <Label Text="Código de lote (opcional)" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="LotCodeEntry" Style="{StaticResource FormEntry}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                                <VerticalStackLayout>
                                    <HorizontalStackLayout Spacing="8">
                                        <CheckBox x:Name="HasManufacturingDateCheck" CheckedChanged="HasManufacturingDateCheck_Changed" />
                                        <Label Text="Registrar fabricación" VerticalOptions="Center" Style="{StaticResource FieldLabel}" />
                                    </HorizontalStackLayout>
                                    <DatePicker x:Name="ManufacturingDatePicker" IsVisible="False" Style="{StaticResource FormDatePicker}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <HorizontalStackLayout Spacing="8">
                                        <CheckBox x:Name="HasExpirationDateCheck" CheckedChanged="HasExpirationDateCheck_Changed" />
                                        <Label Text="Registrar caducidad" VerticalOptions="Center" Style="{StaticResource FieldLabel}" />
                                    </HorizontalStackLayout>
                                    <DatePicker x:Name="ExpirationDatePicker" IsVisible="False" Style="{StaticResource FormDatePicker}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Button Text="Agregar producto" Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" Clicked="AddLine_Clicked" />
                            <Label x:Name="ResultLabel" Style="{StaticResource ErrorText}" />
                        </VerticalStackLayout>
                    </Border>

                    <CollectionView x:Name="LineList" HeightRequest="240">
                        <CollectionView.EmptyView>
                            <Label Text="La entrada todavía no contiene productos." Style="{StaticResource HelperText}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}" Margin="0,4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding DisplayName}" FontAttributes="Bold" />
                                            <Label Text="{Binding DisplayDetail}" Style="{StaticResource HelperText}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="Quitar" Style="{StaticResource SecondaryButton}" Clicked="RemoveLine_Clicked" CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label x:Name="TotalLabel" Text="Total: $0.00" FontSize="18" FontAttributes="Bold" />
                    <Label Text="Notas (opcional)" Style="{StaticResource FieldLabel}" />
                    <Editor x:Name="NotesEntry" Style="{StaticResource FormEditor}" AutoSize="TextChanges" />
                    <Button x:Name="ConfirmEntryButton" Text="Confirmar entrada" Style="{StaticResource PrimaryButton}" HorizontalOptions="Start" Clicked="ConfirmEntry_Clicked" />
                    <Border x:Name="CancellationPanel" Style="{StaticResource ExpiredCard}" IsVisible="False">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Motivo de cancelación *" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="CancelReasonEntry" Style="{StaticResource FormEntry}" />
                            <Button x:Name="CancelEntryButton" Text="Cancelar última entrada" Style="{StaticResource DangerButton}" HorizontalOptions="Start" Clicked="CancelEntry_Clicked" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
