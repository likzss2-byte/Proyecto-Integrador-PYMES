<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventorySystem.AppPages.PurveyorContactPage"
             Title="Proveedor">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label x:Name="CompanyLabel" FontSize="Large" FontAttributes="Bold" />
            <Label x:Name="ContactLabel" />
            <Label x:Name="PhoneLabel" />
            <Label x:Name="EmailLabel" />
            <Label x:Name="LocationLabel" />
            <Label x:Name="AddressLabel" />
            <Label x:Name="NotesLabel" />
            <Label x:Name="StatusLabel" FontAttributes="Bold" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
