<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:templates="clr-namespace:InventorySystem.VisualElementsTemplates"
             x:Class="InventorySystem.AppPages.NewEntryPage"
             Title="Nueva entrada">
    <ScrollView x:Name="PageScroll">
		<VerticalStackLayout Style="{StaticResource StandardTransactionPageContent}">
			<Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Proveedor" Style="{StaticResource FieldLabel}" />
                        <Picker x:Name="SupplierPicker" Style="{StaticResource FormPicker}" Title="Selecciona un proveedor"
                                ItemDisplayBinding="{Binding CompanyName}" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource FormSection}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Agregar producto y lote" Style="{StaticResource SectionTitle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <templates:SearchBar x:Name="ProductSearch" />
                                <Button Grid.Column="1" Text="Escanear" Style="{StaticResource SecondaryButton}" Clicked="ScanCamera_Clicked" />
                            </Grid>
                            <CollectionView x:Name="ProductSearchResults" HeightRequest="180" IsVisible="False" SelectionMode="Single"
                                            SelectionChanged="ProductSearchResults_SelectionChanged">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ListRow}" Margin="0,2">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                                <Label Grid.Column="1" Text="{Binding DisplayStock}" />
                                                <Label Grid.Row="1" Text="{Binding DisplayCode}" Style="{StaticResource HelperText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <Label x:Name="SelectedProductLabel" Style="{StaticResource InfoText}" IsVisible="False" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Cantidad *" Style="{StaticResource FieldLabel}" />
                                    <Entry x:Name="QuantityEntry" Style="{StaticResource FormEntry}" Keyboard="Numeric" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Costo unitario *" Style="{StaticResource FieldLabel}" />
                                    <Entry x:Name="UnitCostEntry" Style="{StaticResource FormEntry}" Keyboard="Numeric" />
                                </VerticalStackLayout>
                            </Grid>
                            <Label Text="Código de lote" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="LotCodeEntry" Style="{StaticResource FormEntry}" />
                            <VerticalStackLayout x:Name="ExpirationSection" IsVisible="False" Spacing="4">
                                <Label Text="Fecha de caducidad del lote *" Style="{StaticResource FieldLabel}" />
                                <DatePicker x:Name="ExpirationDatePicker" Style="{StaticResource FormDatePicker}" />
                            </VerticalStackLayout>
                            <Button x:Name="AddProductButton" Text="Agregar producto" Style="{StaticResource SecondaryButton}"
                                    HorizontalOptions="Start" Clicked="AddLine_Clicked" />
                            <Label x:Name="ResultLabel" Style="{StaticResource ErrorText}" />
                        </VerticalStackLayout>
                    </Border>

                    <CollectionView x:Name="LineList" MinimumHeightRequest="64" ItemSizingStrategy="MeasureAllItems"
                                    VerticalScrollBarVisibility="Never">
                        <CollectionView.EmptyView><Label Text="La entrada todavía no contiene productos." Style="{StaticResource HelperText}" /></CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}" Margin="0,4">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding DisplayName}" FontAttributes="Bold" />
                                            <Label Text="{Binding DisplayDetail}" Style="{StaticResource HelperText}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="Quitar" Style="{StaticResource SecondaryButton}"
                                                Clicked="RemoveLine_Clicked" CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label x:Name="TotalLabel" Text="Total: $0.00" FontSize="18" FontAttributes="Bold" />
                    <Label Text="Notas" Style="{StaticResource FieldLabel}" />
                    <Editor x:Name="NotesEntry" Style="{StaticResource FormEditor}" AutoSize="TextChanges" />
                    <Button x:Name="ConfirmEntryButton" Text="Confirmar entrada" Style="{StaticResource PrimaryButton}"
                            HorizontalOptions="Start" Clicked="ConfirmEntry_Clicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
