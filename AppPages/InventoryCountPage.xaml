<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventorySystem.AppPages.InventoryCountPage"
             Title="Conteo de inventario">
    <ScrollView>
        <VerticalStackLayout Padding="28,24" Spacing="16" MaximumWidthRequest="1240" HorizontalOptions="Center">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="3">
                    <Label x:Name="PageTitleLabel" Style="{StaticResource DesktopPageTitle}" />
                    <Label x:Name="PageSubtitleLabel" Style="{StaticResource DesktopPageSubtitle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Volver" Style="{StaticResource SecondaryButton}" Clicked="Back_Clicked" />
            </Grid>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Sesiones guardadas" Style="{StaticResource SectionTitle}" />
                            <Label Text="Puedes continuar un conteo que todavía no se haya confirmado." Style="{StaticResource HelperText}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Actualizar" Style="{StaticResource SecondaryButton}" Clicked="RefreshSessions_Clicked" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Picker x:Name="OpenSessionsPicker" Style="{StaticResource FormPicker}" Title="Selecciona una sesión guardada" />
                        <Button Grid.Column="1" Text="Continuar sesión" Style="{StaticResource SecondaryButton}" Clicked="ResumeSession_Clicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="StartPanel" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Nueva sesión" Style="{StaticResource SectionTitle}" />
                    <Grid x:Name="SupplierFilterPanel" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="False">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Proveedor *" Style="{StaticResource FieldLabel}" />
                            <Picker x:Name="SupplierPicker" Style="{StaticResource FormPicker}" Title="Selecciona un proveedor activo" ItemDisplayBinding="{Binding CompanyName}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Comenzar conteo" Style="{StaticResource PrimaryButton}" VerticalOptions="End" Clicked="StartSession_Clicked" />
                    </Grid>
                    <Grid x:Name="BrandFilterPanel" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="False">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Marca *" Style="{StaticResource FieldLabel}" />
                            <Picker x:Name="BrandPicker" Style="{StaticResource FormPicker}" Title="Selecciona una marca" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Comenzar conteo" Style="{StaticResource PrimaryButton}" VerticalOptions="End" Clicked="StartSession_Clicked" />
                    </Grid>
                    <Grid x:Name="FreeStartPanel" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="False">
                        <Label Text="Agrega los productos conforme los encuentres. El inventario no cambiará hasta que confirmes." Style="{StaticResource HelperText}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Comenzar conteo libre" Style="{StaticResource PrimaryButton}" Clicked="StartSession_Clicked" />
                    </Grid>
                    <Label x:Name="StartErrorLabel" Style="{StaticResource ErrorText}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="SessionPanel" Spacing="16" IsVisible="False">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="14">
                            <VerticalStackLayout Spacing="2">
                                <Label x:Name="SessionReferenceLabel" Style="{StaticResource SectionTitle}" />
                                <Label x:Name="SessionFilterLabel" Style="{StaticResource HelperText}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Avance" Style="{StaticResource FieldLabel}" />
                                <Label x:Name="ProgressLabel" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" x:Name="PendingLabel" VerticalOptions="Center" Style="{StaticResource InfoText}" />
                        </Grid>

                        <Grid x:Name="FreeProductPanel" ColumnDefinitions="1.2*,Auto,Auto,1.4*,Auto" ColumnSpacing="10" IsVisible="False">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Escáner, código de barras o SKU" Style="{StaticResource FieldLabel}" />
                                <Entry x:Name="ScanCodeEntry" Style="{StaticResource FormEntry}" ReturnType="Go" Completed="ScanCode_Completed" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Agregar" Style="{StaticResource PrimaryButton}" VerticalOptions="End" Clicked="AddByCode_Clicked" />
                            <Button Grid.Column="2" Text="Escanear con cámara" Style="{StaticResource SecondaryButton}" VerticalOptions="End" Clicked="ScanCamera_Clicked" />
                            <VerticalStackLayout Grid.Column="3" Spacing="4">
                                <Label Text="Buscar por nombre" Style="{StaticResource FieldLabel}" />
                                <Entry x:Name="FreeSearchEntry" Style="{StaticResource FormEntry}" TextChanged="FreeSearch_TextChanged" />
                                <Picker x:Name="FreeProductPicker" Style="{StaticResource FormPicker}" Title="Selecciona un resultado" ItemDisplayBinding="{Binding Name}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="4" Text="Agregar selección" Style="{StaticResource SecondaryButton}" VerticalOptions="End" Clicked="AddSelectedProduct_Clicked" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Entry x:Name="SessionSearchEntry" Style="{StaticResource FormEntry}" Placeholder="Filtrar productos de esta sesión" TextChanged="SessionSearch_TextChanged" />
                            <Button Grid.Column="1" Text="Limpiar filtro" Style="{StaticResource SecondaryButton}" Clicked="ClearSearch_Clicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="12">
                    <VerticalStackLayout Spacing="0">
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                            <Grid RowDefinitions="Auto,410" MinimumWidthRequest="1110">
                                <Border Style="{StaticResource TableHeader}">
                                    <Grid ColumnDefinitions="145,2*,150,135,100,100,155" ColumnSpacing="10">
                                        <Label Text="Código" FontAttributes="Bold" />
                                        <Label Grid.Column="1" Text="Nombre" FontAttributes="Bold" />
                                        <Label Grid.Column="2" Text="Inventario físico" FontAttributes="Bold" />
                                        <Label Grid.Column="3" Text="Inventario teórico" FontAttributes="Bold" />
                                        <Label Grid.Column="4" Text="Faltante" FontAttributes="Bold" />
                                        <Label Grid.Column="5" Text="Sobrante" FontAttributes="Bold" />
                                        <Label Grid.Column="6" Text="Estado / acciones" FontAttributes="Bold" />
                                    </Grid>
                                </Border>
                                <CollectionView x:Name="CountRowsList" Grid.Row="1" SelectionMode="Single">
                                    <CollectionView.EmptyView>
                                        <Label Text="No hay productos en esta sesión." Style="{StaticResource HelperText}" HorizontalOptions="Center" Margin="0,30" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TableRow}" BackgroundColor="{Binding RowBackground}">
                                                <Grid ColumnDefinitions="145,2*,150,135,100,100,155" ColumnSpacing="10">
                                                    <Label Text="{Binding Code}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                        <Label Text="{Binding ProductName}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding ProductDetail}" Style="{StaticResource HelperText}" />
                                                    </VerticalStackLayout>
                                                    <Entry Grid.Column="2" Text="{Binding PhysicalText, Mode=TwoWay}" Style="{StaticResource FormEntry}" Keyboard="Numeric" ReturnType="Next" Completed="PhysicalEntry_Completed" />
                                                    <Label Grid.Column="3" Text="{Binding TheoreticalDisplay}" VerticalOptions="Center" />
                                                    <Label Grid.Column="4" Text="{Binding MissingDisplay}" TextColor="#9B2C21" FontAttributes="Bold" VerticalOptions="Center" />
                                                    <Label Grid.Column="5" Text="{Binding SurplusDisplay}" TextColor="#28723D" FontAttributes="Bold" VerticalOptions="Center" />
                                                    <VerticalStackLayout Grid.Column="6" Spacing="3" VerticalOptions="Center">
                                                        <Label Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontAttributes="Bold" FontSize="12" />
                                                        <Button Text="{Binding LotActionText}" IsVisible="{Binding CanCountLots}" Style="{StaticResource TableActionButton}" Clicked="OpenLots_Clicked" />
                                                        <Button Text="Quitar" IsVisible="{Binding CanRemove}" Style="{StaticResource TableActionButton}" Clicked="RemoveProduct_Clicked" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="LotPanel" Style="{StaticResource AlertCard}" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label x:Name="LotProductLabel" Style="{StaticResource SectionTitle}" />
                                <Label Text="Captura todos los lotes. La suma será el inventario físico del producto." Style="{StaticResource HelperText}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Cerrar" Style="{StaticResource SecondaryButton}" Clicked="CloseLots_Clicked" />
                        </Grid>
                        <Border Style="{StaticResource TableHeader}">
                            <Grid ColumnDefinitions="2*,150,140,150,120" ColumnSpacing="10">
                                <Label Text="Lote" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="Caducidad" FontAttributes="Bold" />
                                <Label Grid.Column="2" Text="Teórico" FontAttributes="Bold" />
                                <Label Grid.Column="3" Text="Físico" FontAttributes="Bold" />
                                <Label Grid.Column="4" Text="Diferencia" FontAttributes="Bold" />
                            </Grid>
                        </Border>
                        <CollectionView x:Name="LotRowsList" HeightRequest="230">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow}">
                                        <Grid ColumnDefinitions="2*,150,140,150,120" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                                <Label Text="{Binding LotCode}" FontAttributes="Bold" />
                                                <Label Text="{Binding ExpirationStatus}" Style="{StaticResource HelperText}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding ExpirationDisplay}" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding TheoreticalDisplay}" VerticalOptions="Center" />
                                            <Entry Grid.Column="3" Text="{Binding PhysicalText, Mode=TwoWay}" Style="{StaticResource FormEntry}" Keyboard="Numeric" ReturnType="Next" Completed="LotPhysicalEntry_Completed" />
                                            <Label Grid.Column="4" Text="{Binding DifferenceDisplay}" VerticalOptions="Center" FontAttributes="Bold" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Button Text="Guardar conteo de lotes" Style="{StaticResource PrimaryButton}" HorizontalOptions="Start" Clicked="SaveLots_Clicked" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Notas de la sesión (opcional)" Style="{StaticResource FieldLabel}" />
                        <Editor x:Name="SessionNotesEditor" Style="{StaticResource FormEditor}" AutoSize="TextChanges" />
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
                            <Button Text="Guardar avance" Style="{StaticResource SecondaryButton}" Clicked="SaveProgress_Clicked" />
                            <Button Grid.Column="1" Text="Confirmar inventario" Style="{StaticResource PrimaryButton}" Clicked="ConfirmSession_Clicked" />
                            <Button Grid.Column="2" Text="Cancelar sesión" Style="{StaticResource DangerButton}" Clicked="CancelSession_Clicked" />
                            <Label Grid.Column="3" x:Name="SessionMessageLabel" HorizontalTextAlignment="End" VerticalOptions="Center" Style="{StaticResource InfoText}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
