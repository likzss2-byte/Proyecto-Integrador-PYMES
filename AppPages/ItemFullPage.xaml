<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventorySystem.AppPages.ItemFullPage"
             Title="Producto">
    <ScrollView>
        <VerticalStackLayout x:Name="PageContent" Style="{StaticResource StandardDetailPageContent}">
            <VerticalStackLayout Spacing="3">
                <Label x:Name="ProductNameLabel" Style="{StaticResource DesktopPageTitle}" />
                <Label x:Name="ProductCodeLabel" Style="{StaticResource HelperText}" />
                <Label x:Name="ProductStockLabel" Style="{StaticResource HelperText}" />
                <Label x:Name="ExpirationStatusLabel" Style="{StaticResource HelperText}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Datos del producto" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Código de barras" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="BarcodeEntry" Style="{StaticResource FormEntry}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Nombre *" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="NameEntry" Style="{StaticResource FormEntry}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Marca" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="BrandEntry" Style="{StaticResource FormEntry}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Descripción" Style="{StaticResource FieldLabel}" />
                            <Editor x:Name="DescriptionEntry" Style="{StaticResource FormEditor}" AutoSize="TextChanges" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Unidad de medida" Style="{StaticResource FieldLabel}" />
                            <Picker x:Name="UnitPicker" Style="{StaticResource FormPicker}">
                                <Picker.Items><x:String>Unidad</x:String><x:String>Kilogramo</x:String><x:String>Litro</x:String></Picker.Items>
                            </Picker>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Control de caducidad" Style="{StaticResource FieldLabel}" />
                            <Picker x:Name="ExpirationModePicker" Style="{StaticResource FormPicker}">
                                <Picker.Items><x:String>Con fecha por lote</x:String><x:String>No perecedero</x:String></Picker.Items>
                            </Picker>
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Stock mínimo" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="MinimumStockEntry" Style="{StaticResource FormEntry}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Precio de venta" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="SalePriceEntry" Style="{StaticResource FormEntry}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                    </Grid>
                    <HorizontalStackLayout Spacing="8">
                        <Switch x:Name="ActiveSwitch" />
                        <Label Text="Producto activo" VerticalOptions="Center" Style="{StaticResource FieldLabel}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="10">
                        <Button x:Name="SaveProductButton" Text="Guardar cambios" Style="{StaticResource PrimaryButton}" Clicked="SaveProduct_Clicked" />
                        <Button x:Name="DeleteProductButton" Text="Eliminar producto" Style="{StaticResource SecondaryButton}" Clicked="DeleteProduct_Clicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Proveedor(es) de este producto" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
                        <Picker x:Name="AvailableSupplierPicker" Style="{StaticResource FormPicker}"
                                Title="Selecciona un proveedor" ItemDisplayBinding="{Binding CompanyName}" />
                        <Entry x:Name="SupplierReferenceCostEntry" Grid.Column="1" Style="{StaticResource FormEntry}"
                               Keyboard="Numeric" Placeholder="Costo unitario" />
                        <Button x:Name="AddSupplierButton" Grid.Column="2" Text="Agregar"
                                Style="{StaticResource SecondaryButton}" Clicked="AddSupplier_Clicked" />
                    </Grid>
                    <CollectionView x:Name="SupplierList" HeightRequest="180" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="Este producto no tiene proveedores asociados." Style="{StaticResource HelperText}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}" Margin="0,3">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Supplier.CompanyName}" FontAttributes="Bold" />
                                            <Label Text="{Binding DisplayReferenceCost}" Style="{StaticResource HelperText}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="Editar costo" Style="{StaticResource SecondaryButton}"
                                                CommandParameter="{Binding .}" Clicked="EditSupplierCost_Clicked" />
                                        <Button Grid.Column="2" Text="Ver" Style="{StaticResource SecondaryButton}"
                                                CommandParameter="{Binding Supplier}" Clicked="OpenSupplier_Clicked" />
                                        <Button Grid.Column="3" Text="Quitar" Style="{StaticResource SecondaryButton}"
                                                CommandParameter="{Binding Supplier}" Clicked="RemoveSupplier_Clicked" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Lotes de este producto" Style="{StaticResource SectionTitle}" />
                        <Button Grid.Column="1" Text="Ver todos los lotes" Style="{StaticResource SecondaryButton}" Clicked="OpenLots_Clicked" />
                    </Grid>
                    <CollectionView x:Name="LotList" HeightRequest="300" SelectionMode="Single" SelectionChanged="LotList_SelectionChanged">
                        <CollectionView.EmptyView><Label Text="Este producto todavía no tiene lotes." Style="{StaticResource HelperText}" /></CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}" Margin="0,3">
                                    <Grid ColumnDefinitions="2*,*,*,*">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding LotCode, StringFormat='Lote {0}'}" FontAttributes="Bold" />
                                            <Label Text="{Binding SupplierName}" Style="{StaticResource HelperText}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='Disponible {0:0.###}'}" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding DisplayExpiration}" VerticalOptions="Center" />
                                        <Label Grid.Column="3" Text="{Binding EffectiveStatus}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
            <Label x:Name="DetailErrorLabel" Style="{StaticResource ErrorText}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
