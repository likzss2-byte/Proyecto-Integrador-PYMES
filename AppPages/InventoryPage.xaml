<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:templates="clr-namespace:InventorySystem.VisualElementsTemplates"
             x:Class="InventorySystem.AppPages.InventoryPage"
             Title="Inventario">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="28,24,28,0" MaximumWidthRequest="1180" HorizontalOptions="Center">
        <VerticalStackLayout Spacing="4">
            <Label Text="Inventario" Style="{StaticResource DesktopPageTitle}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Consulta existencias, lotes e historial." Style="{StaticResource DesktopPageSubtitle}" />
        </VerticalStackLayout>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14">
            <VerticalStackLayout Spacing="10">
                <Label Text="Conteo físico" Style="{StaticResource SectionTitle}" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Button Text="Por proveedor" Style="{StaticResource SecondaryButton}" Clicked="OpenSupplierInventory_Clicked" />
                    <Button Grid.Column="1" Text="Por marca" Style="{StaticResource SecondaryButton}" Clicked="OpenBrandInventory_Clicked" />
                    <Button Grid.Column="2" Text="Inventario operativo" Style="{StaticResource PrimaryButton}" Clicked="OpenOperationalInventory_Clicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,14,0,10">
            <templates:SearchBar x:Name="InventorySearch" />
            <templates:SortButton x:Name="InventorySortButton" Grid.Column="1" SortChanged="InventorySortButton_SortChanged" />
        </Grid>
        <CollectionView x:Name="InventoryItems" Grid.Row="3" SelectionMode="Single" SelectionChanged="InventoryItems_SelectionChanged">
            <CollectionView.EmptyView>
                <Label Text="Aún no hay productos por mostrar." HorizontalOptions="Center" VerticalOptions="Center" Style="{StaticResource HelperText}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ListRow}" Margin="0,4" Padding="12">
                        <Grid ColumnDefinitions="2*,*,Auto" RowDefinitions="Auto,Auto">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                            <Label Grid.Row="1" Text="{Binding DisplayCode}" Style="{StaticResource HelperText}" />
                            <Label Grid.Column="1" Text="{Binding Brand}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding ExpirationMode}" Style="{StaticResource HelperText}" />
                            <Label Grid.Column="2" Grid.RowSpan="2" Text="{Binding DisplayStock}" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <templates:Dock Grid.Row="4" IsVisible="{OnPlatform WinUI=False, Default=True}" VerticalOptions="End" />
    </Grid>
</ContentPage>
