<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
			 xmlns:templates="clr-namespace:InventorySystem.VisualElementsTemplates"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventorySystem.AppPages.InventoryPage"
			 Shell.NavBarIsVisible="False">

	<Grid
		RowDefinitions="Auto,*,Auto,Auto,Auto"
		>
		<Grid
			Grid.Row="0"
			>
			<Border
			BackgroundColor="#75E843"
			Opacity="1"
			HorizontalOptions="Fill"
			Padding="28"
			>
			</Border>
			<Label
				Margin="16,2,0,0"
				VerticalOptions="Center"
				HorizontalOptions="Start"
				FontAttributes="Bold"
				FontSize="Large"
				Text="Inventario"
				Style="{StaticResource PageTitle}"
				SemanticProperties.HeadingLevel="Level1"
			/>
		</Grid>
		<CollectionView
			x:Name="InventoryItems"
			Grid.Row="1"
			Margin="20,12"
			SelectionMode="Single"
			SelectionChanged="InventoryItems_SelectionChanged">
			<CollectionView.EmptyView>
				<Label Text="Aún no hay elementos por mostrar" HorizontalOptions="Center" VerticalOptions="Center" />
			</CollectionView.EmptyView>
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<Border Margin="0,4" Padding="12" Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#505050}" StrokeShape="RoundRectangle 12">
						<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
							<Label Text="{Binding Name}" FontAttributes="Bold" />
							<Label Grid.Row="1" Text="{Binding DisplayCode}" FontSize="Small" />
							<Label Grid.Column="1" Grid.RowSpan="2" Text="{Binding DisplayStock}" VerticalOptions="Center" />
						</Grid>
					</Border>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
		<templates:SortButton
			x:Name="InventorySortButton"
			SortChanged="InventorySortButton_SortChanged"
			Grid.Row="2"
			HorizontalOptions="End"
			Margin="22,12,22,12"
			IsVisible="True"/>
		<templates:SearchBar
			x:Name="InventorySearch"
			Grid.Row="3"
			VerticalOptions="End">
		</templates:SearchBar>
		<templates:Dock
			Grid.Row="4"
			VerticalOptions="End">
		</templates:Dock>
	</Grid>
</ContentPage>
