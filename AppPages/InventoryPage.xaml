<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:templates="clr-namespace:InventorySystem.VisualElementsTemplates"
             x:Class="InventorySystem.AppPages.InventoryPage"
             Title="Inventario">
    <Shell.TitleView><Grid /></Shell.TitleView>
    <Grid x:Name="PageRoot" RowDefinitions="Auto,Auto,*,Auto" Padding="32,24,32,0">
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid x:Name="SortGrid" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button x:Name="RecentSortButton" Text="Recientes ▼" Style="{StaticResource PrimaryButton}"
                        Clicked="RecentSort_Clicked" />
                <Button x:Name="AlphabeticalSortButton" Grid.Column="1" Text="Alfabético"
                        Style="{StaticResource SecondaryButton}" Clicked="AlphabeticalSort_Clicked" />
                <Button x:Name="PriceSortButton" Grid.Column="2" Text="Precio"
                        Style="{StaticResource SecondaryButton}" Clicked="PriceSort_Clicked" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,12">
            <templates:SearchBar x:Name="InventorySearch" HorizontalOptions="Fill" />
            <Button Grid.Column="1" Text="Escanear" Style="{StaticResource SecondaryButton}"
                    VerticalOptions="Center" Clicked="ScanInventoryCamera_Clicked" />
        </Grid>

        <CollectionView x:Name="InventoryItems" Grid.Row="2" SelectionMode="Single"
                        SelectionChanged="InventoryItems_SelectionChanged" VerticalOptions="Fill">
            <CollectionView.EmptyView>
                <Label Text="No hay productos por mostrar." Margin="0,24" HorizontalOptions="Center"
                       Style="{StaticResource HelperText}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ListRow}" Margin="0,4">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" LineBreakMode="WordWrap" />
                            <Label Grid.Column="1" Text="{Binding DisplayStock}" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Row="1" Text="{Binding Brand}" LineBreakMode="WordWrap" />
                            <Label Grid.Row="2" Text="{Binding DisplayCode}" Style="{StaticResource HelperText}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding ExpirationMode}"
                                   Style="{StaticResource HelperText}" HorizontalTextAlignment="End" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <templates:Dock Grid.Row="3" MaximumWidthRequest="1080" HorizontalOptions="Fill"
                        IsVisible="{OnPlatform WinUI=False, Default=True}" VerticalOptions="End" />
    </Grid>
</ContentPage>
