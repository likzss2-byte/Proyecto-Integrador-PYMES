<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
			 xmlns:templates="clr-namespace:InventorySystem.VisualElementsTemplates"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventorySystem.AppPages.InventoryPage"
			 Shell.NavBarIsVisible="False">

	<Grid
		RowDefinitions="Auto,*,Auto,Auto,Auto"
		>
		<Grid
			Grid.Row="0"
			>
			<Border
			BackgroundColor="#75E843"
			Opacity="1"
			HorizontalOptions="Fill"
			Padding="28"
			>
			</Border>
			<Label
				Margin="16,2,0,0"
				VerticalOptions="Center"
				HorizontalOptions="Start"
				FontAttributes="Bold"
				FontSize="Large"
				Text="Inventario"
				Style="{StaticResource PageTitle}"
				SemanticProperties.HeadingLevel="Level1"
			/>
		</Grid>
		<templates:SortButton 
			x:Name="InventorySortButton"
			SortChanged="InventorySortButton_SortChanged"
			Grid.Row="2"
			HorizontalOptions="End"
			Margin="22,12,22,12"
			IsVisible="True"/>
		<templates:SearchBar
			Grid.Row="3"
			VerticalOptions="End">
		</templates:SearchBar>
		<templates:Dock
			Grid.Row="4"
			VerticalOptions="End">
		</templates:Dock>
	</Grid>
</ContentPage>