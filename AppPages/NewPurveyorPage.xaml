<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventorySystem.AppPages.NewPurveyorPage"
             Title="Nuevo proveedor">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">
            <Label Text="Registrar proveedor" FontSize="Large" FontAttributes="Bold" />
            <Entry x:Name="CompanyEntry" Placeholder="Empresa o razón social *" />
            <Entry x:Name="ContactEntry" Placeholder="Nombre del contacto" />
            <Entry x:Name="PhoneEntry" Placeholder="Teléfono" Keyboard="Telephone" />
            <Entry x:Name="EmailEntry" Placeholder="Correo" Keyboard="Email" />
            <Entry x:Name="CountryEntry" Placeholder="País" />
            <Entry x:Name="StateEntry" Placeholder="Estado" />
            <Editor x:Name="AddressEntry" Placeholder="Dirección" AutoSize="TextChanges" />
            <Editor x:Name="NotesEntry" Placeholder="Notas" AutoSize="TextChanges" />
            <HorizontalStackLayout Spacing="8">
                <Label Text="Activo" VerticalOptions="Center" />
                <Switch x:Name="ActiveSwitch" IsToggled="True" />
            </HorizontalStackLayout>
            <Button Text="Guardar proveedor" BackgroundColor="#75E843" Clicked="SaveSupplier_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
