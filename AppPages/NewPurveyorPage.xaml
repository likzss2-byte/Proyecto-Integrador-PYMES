<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventorySystem.AppPages.NewPurveyorPage"
             Title="Agregar proveedor">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource StandardCreatePageContent}">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Información principal" Style="{StaticResource SectionTitle}" />
                    <Label Text="Empresa o razón social *" Style="{StaticResource FieldLabel}" />
                    <Entry x:Name="CompanyEntry" Style="{StaticResource FormEntry}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Nombre del contacto" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="ContactEntry" Style="{StaticResource FormEntry}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Teléfono" Style="{StaticResource FieldLabel}" />
                            <VerticalStackLayout x:Name="PhoneEntriesContainer" Spacing="6">
                                <Entry x:Name="PhoneEntry" Style="{StaticResource FormEntry}" Keyboard="Telephone" TextChanged="ContactField_TextChanged" />
                            </VerticalStackLayout>
                            <Button x:Name="AddPhoneButton" Text="+ Agregar otro teléfono" IsVisible="False"
                                    Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" Clicked="AddPhone_Clicked" />
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Correo" Style="{StaticResource FieldLabel}" />
                        <VerticalStackLayout x:Name="EmailEntriesContainer" Spacing="6">
                            <Entry x:Name="EmailEntry" Style="{StaticResource FormEntry}" Keyboard="Email" TextChanged="ContactField_TextChanged" />
                        </VerticalStackLayout>
                        <Button x:Name="AddEmailButton" Text="+ Agregar otro correo" IsVisible="False"
                                Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" Clicked="AddEmail_Clicked" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="País" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="CountryEntry" Style="{StaticResource FormEntry}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Estado" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="StateEntry" Style="{StaticResource FormEntry}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Dirección" Style="{StaticResource FieldLabel}" />
                            <Editor x:Name="AddressEntry" Style="{StaticResource FormEditor}" AutoSize="TextChanges" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Notas" Style="{StaticResource FieldLabel}" />
                            <Editor x:Name="NotesEntry" Style="{StaticResource FormEditor}" AutoSize="TextChanges" />
                        </VerticalStackLayout>
                    </Grid>
                    <HorizontalStackLayout Spacing="8">
                        <Switch x:Name="ActiveSwitch" IsToggled="True" />
                        <Label Text="Proveedor activo" VerticalOptions="Center" Style="{StaticResource FieldLabel}" />
                    </HorizontalStackLayout>
                    <Label x:Name="SupplierErrorLabel" Style="{StaticResource ErrorText}" />
                    <Button Text="Guardar proveedor" Style="{StaticResource PrimaryButton}" HorizontalOptions="Start" Clicked="SaveSupplier_Clicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
