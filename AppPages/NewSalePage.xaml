<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventorySystem.AppPages.NewSalePage"
             Title="Nueva venta">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">
            <Label Text="Venta / salida" FontSize="Large" FontAttributes="Bold" />
            <Entry x:Name="ProductCodeEntry" Placeholder="Código de barras o SKU" Completed="AddLine_Clicked" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Entry x:Name="QuantityEntry" Placeholder="Cantidad" Keyboard="Numeric" />
                <Entry x:Name="UnitPriceEntry" Grid.Column="1" Placeholder="Precio unitario" Keyboard="Numeric" />
            </Grid>
            <Button Text="Agregar producto" Clicked="AddLine_Clicked" />
            <CollectionView x:Name="LineList" HeightRequest="240">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding DisplayName}" FontAttributes="Bold" />
                                <Label Text="{Binding DisplayDetail}" FontSize="Small" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Quitar" Clicked="RemoveLine_Clicked" CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label x:Name="TotalLabel" Text="Total: $0.00" FontAttributes="Bold" />
            <Editor x:Name="NotesEntry" Placeholder="Notas" AutoSize="TextChanges" />
            <Button Text="Confirmar venta" BackgroundColor="#75E843" Clicked="ConfirmSale_Clicked" />
            <Entry x:Name="CancelReasonEntry" Placeholder="Motivo de cancelación" IsVisible="False" />
            <Button x:Name="CancelSaleButton" Text="Cancelar última venta" IsVisible="False" Clicked="CancelSale_Clicked" />
            <Label x:Name="ResultLabel" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
